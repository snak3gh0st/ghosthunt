# Copy to ~/.bounty.env (or ./.env) and fill in. bounty.py auto-loads it.
# Never commit the real file.

# --- HackerOne API (generate at https://hackerone.com/settings/api_token) ---
HACKERONE_API_USERNAME=your_h1_username
HACKERONE_API_TOKEN=your_h1_api_token

# --- LLM for `bounty ask` (OpenAI-compatible) ---
BOUNTY_API_KEY=sk-...
BOUNTY_MODEL=gpt-4o
BOUNTY_BASE_URL=https://api.openai.com/v1

# --- Engines (optional overrides) ---
# Where the cloned engines live if you run bounty.py from another dir:
BOUNTY_ENGINES_DIR=/home/snakeghost/bugbounty/engines
# Explicit engine binaries if not on PATH:
# NIGHTWATCH_BIN=python3 -m nighwatch
# BOUNTY_STRIX_BIN=strix

# --- Local LLM (Ollama = free, no token cost) ---
# Set BOUNTY_LLM=local to route ALL AI (ask + hunt triage) to Ollama by default.
# Or leave unset and use `--local` per command / [Y] in the hunt menu.
# BOUNTY_LLM=local
BOUNTY_OLLAMA_URL=http://127.0.0.1:11434/v1
BOUNTY_OLLAMA_MODEL=llama3.1
